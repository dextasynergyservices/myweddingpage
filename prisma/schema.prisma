// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  INACTIVE
  PAID
}

enum PaymentProvider {
  STRIPE
  PAYSTACK
}

enum PaymentStatus {
  SUCCESS
  FAILED
  PENDING
}

enum MediaType {
  PHOTO
  VIDEO
}

enum ReminderType {
  TWO_WEEKS
  ONE_WEEK
  DAILY
}

enum MediaCategory {
  before
  during
  after
}

enum SectionType {
  HERO
  STORY
  GALLERY
  REGISTRY
  WISHES
}

model User {
  id                String        @id @default(uuid())
  email             String?        @unique
  emailVerified     DateTime?
  image             String?
  groomName         String?
  brideName         String?
  weddingDate       DateTime?
  password String?
  role              UserRole      @default(USER)
  planId            String?
  plan              Plan?         @relation(fields: [planId], references: [id])
  subscription_start DateTime?
  subscription_end   DateTime?
  status            SubscriptionStatus @default(INACTIVE)

  gracePeriodStart  DateTime?     // When grace period started (when plan expired)
  gracePeriodEnd    DateTime?     // When grace period ends (3 days after expiration)
  isInGracePeriod   Boolean       @default(false)

  whatsapp           String?  @unique
  verification_code  String?
  verification_token   String?
  code_expires_at      DateTime?
  email_verified_at    DateTime?
  whatsapp_verified_at DateTime?

  created_at        DateTime      @default(now())

  accounts           Account[]
  sessions           Session[]

  weddingPages      WeddingPage[]
  payments          Payment[]
  emailReminders    EmailReminder[]
  subscriptions      Subscription[]  @relation("UserSubscriptions")
  passwordResetTokens PasswordResetToken[]
  expirationLogs  ExpirationLog[]
  gifts         Gift[]
  bankDetails   BankDetail[]
  receivedGifts ReceivedGift[]
  comments      Comment[]
  guests        Guest[]
  tasks         Task[]
  streams       Stream[]
  userTemplates     UserTemplate[]
  galleryMedias GalleryMedia[]
}

model Plan {
  id          String   @id @default(uuid())
  name        String
  price       Decimal
  renewalOptions    PlanRenewalOption[]
  duration_days Int
  max_photos  Int
  max_videos  Int
  max_tabs    Int
  gradient     String?
  popular      Boolean?
  created_at  DateTime @default(now())

  users       User[]
  payments    Payment[]
  subscriptions Subscription[]
  templates  PlanTemplate[]
}

model Payment {
  id              String          @id @default(uuid())
  userId          String
  planId          String
  amount          Decimal
  payment_provider PaymentProvider
  status          PaymentStatus
  paid_at         DateTime
  reference       String? @unique
  trxref           String?

  user            User   @relation(fields: [userId], references: [id])
  plan            Plan   @relation(fields: [planId], references: [id])
}

model Template {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String
  thumbnail    String
  layout_data   Json
  categoryId   String
  category     TemplateCategory @relation(fields: [categoryId], references: [id])
  components   Json
  colorSchemes Json
  hero_image  String?
  previewData  Json?
  isActive      Boolean  @default(true)
  created_at    DateTime @default(now())

  weddingPages  WeddingPage[]
  planTemplate  PlanTemplate[]
  userTemplates UserTemplate[]
  sections       TemplateSection[]
}

model TemplateSection {
  id          String   @id @default(cuid())
  templateId  String
  template    Template @relation(fields: [templateId], references: [id])

  type        SectionType   // HERO, STORY, GALLERY, REGISTRY, WISHES
  layout      String        // e.g. "hero_split_image_text", "story_timeline"
  components  Json          // holds config: slots, typography, positions, etc.
  order       Int           // order on the page

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model TemplateCategory {
  id          String     @id @default(uuid())
  name        String     @unique
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  templates   Template[]
}

model PlanTemplate {
  id         String   @id @default(uuid())
  planId   String
  templateId String
  created_at DateTime @default(now())

  plan       Plan     @relation(fields: [planId], references: [id])
  template   Template @relation(fields: [templateId], references: [id])

  @@unique([planId, templateId])
}

model UserTemplate {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  templateId  String
  template    Template @relation(fields: [templateId], references: [id])
  colorScheme Json
  content     Json
  isSelected  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, templateId])
}

model WeddingPage {
  id                String   @id @default(uuid())
  userId            String
  templateId        String
  title             String
  slug              String   @unique
  views             Int      @default(0)
  ai_data           Json?
  layout_data       Json?
  color_theme       String?

  hero_image        String?
  story_image       String?
  logo_url          String?
  logo_alt          String?
  venue             String?
  welcomeMessage    String?

  is_live           Boolean  @default(false)
  created_by_admin  Boolean  @default(false)
  created_at        DateTime @default(now())

  deleted_at        DateTime?
  deletion_reason   String?   // e.g., "subscription_expired", "user_requested"

  user              User      @relation(fields: [userId], references: [id])
  template          Template  @relation(fields: [templateId], references: [id])
  mediaUploads      MediaUpload[]
  comments          Comment[]
}

model MediaUpload {
  id              String     @id @default(uuid())
  weddingPageId   String
  type            MediaType
  cloudinary_url  String
  uploaded_at     DateTime   @default(now())

  weddingPage     WeddingPage @relation(fields: [weddingPageId], references: [id])
}

model Comment {
  id              String     @id @default(uuid())
  weddingPageId   String
  name            String
  message         String
  approved        Boolean    @default(false)
  created_at      DateTime   @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  weddingPage     WeddingPage @relation(fields: [weddingPageId], references: [id])
}

model EmailReminder {
  id          String        @id @default(uuid())
  userId      String
  type        ReminderType
  sent_at     DateTime

  user        User          @relation(fields: [userId], references: [id])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id])
}
model Subscription {
  id          String   @id @default(uuid())
  email       String
  whatsapp    String
  planId      String
  userId           String?
  user             User?        @relation(fields: [userId], references: [id], name: "UserSubscriptions")
  plan        Plan     @relation(fields: [planId], references: [id])
  amount      Decimal
  status      SubscriptionStatus @default(ACTIVE)
  token       String   @unique
  paystackReference String? @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  expirationLogs  ExpirationLog[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  expires   DateTime
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model ExpirationLog {
  id              String   @id @default(cuid())
  subscriptionId  String?
  userId          String?
  expiredAt       DateTime @default(now())
  subscriptionEnd DateTime

  user            User?         @relation(fields: [userId], references: [id])
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])
}

model PlanRenewalOption {
  id        String   @id @default(cuid())
  planId    String
  duration  Int
  price     Decimal
  plan      Plan     @relation(fields: [planId], references: [id])
  createdAt DateTime @default(now())

  @@unique([planId, duration])
}

model Gift {
  id          String     @id @default(cuid())
  name        String
  description String
  price       Float
  image       String?
  link        String?
  purchasedBy String?
  purchased   Boolean   @default(false)
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model BankDetail {
  id            String   @id @default(cuid())
  bankName      String
  accountNumber String
  accountName   String
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ReceivedGift {
  id          String   @id @default(cuid())
  name        String
  giftId      String?
  amount      Float?
  message     String?
  date        DateTime @default(now())
  image       String?
  thanked     Boolean  @default(false)
  thankedAt   DateTime?
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  contactEmail String?
  contactPhone String?
}

model Guest {
  id                  String   @id @default(cuid())
  name                String
  email               String?
  phone               String?
  customMessage       String?
  invitationCard      String?
  rsvpStatus          String   @default("PENDING") // PENDING, ATTENDING, DECLINED
  mealPreference      String?
  tableAssignment     Int?
  plusOne             Boolean  @default(false)
  dietaryRestrictions String?
  invitedBy           String   // BRIDE, GROOM, BOTH
  category            String   // FAMILY, FRIENDS, COLLEAGUES, OTHER
  invitationToken     String   @unique
  userId              String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Task {
  id            String     @id @default(cuid())
  title         String
  description   String
  TaskCategoryId    String
  TaskCategory      TaskCategory   @relation(fields: [TaskCategoryId], references: [id])
  TaskPriorityId    String
  TaskPriority      TaskPriority   @relation(fields: [TaskPriorityId], references: [id])
  dueDate       DateTime
  assignedTo    String?
  completed     Boolean    @default(false)
  completedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  userId        String
  user          User       @relation(fields: [userId], references: [id])
  phone         String?
  email         String?
  estimatedTime Int?
  token         String     @unique @default(cuid())
}

model TaskCategory {
  id    String @id @default(cuid())
  name  String
  color String
  icon  String
  tasks Task[]
}

model TaskPriority {
  id    String @id @default(cuid())
  name  String   // e.g., Low, Medium, High
  level Int      // e.g., 1 = Low, 2 = Medium, 3 = High
  color String?  // Optional for UI styling
  tasks Task[]
}

model Stream {
  id          String   @id @default(cuid())
  name        String
  youtubeUrl  String
  youtubeId   String
  camera      String
  quality     String
  isActive    Boolean  @default(false)
  viewerCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GalleryMedia {
  id        String   @id @default(uuid())
  url       String
  type      MediaType
  category  MediaCategory
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}