option_settings:
  aws:elasticbeanstalk:container:nodejs:
    NodeCommand: "pnpm start"

  aws:elasticbeanstalk:application:environment:
    NODE_ENV: "production"
    NEXT_TELEMETRY_DISABLED: "1"
    NEXT_SHARP_PATH: "/var/app/current/node_modules/sharp"

  aws:elasticbeanstalk:environment:proxy:
    ProxyServer: nginx

files:
  "/etc/nginx/conf.d/proxy.conf":
    content: |
      client_max_body_size 50M;
      proxy_read_timeout 300;

packages:
  yum:
    git: []

commands:
  01_install_pnpm:
    command: "npm install -g pnpm"
    test: "[ ! -f /usr/bin/pnpm ]"

container_commands:
  01_install_dependencies:
    command: "pnpm install --frozen-lockfile"
    cwd: "/var/app/staging"

  02_generate_prisma:
    command: "pnpm prisma generate"
    cwd: "/var/app/staging"

  03_build_application:
    command: "pnpm build"
    cwd: "/var/app/staging"

  04_cleanup_dev_dependencies:
    command: "pnpm prune --prod"
    cwd: "/var/app/staging"